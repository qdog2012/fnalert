#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/common"

APP_NAME="$(fnmonitor_app_name)"
APP_DIR="$(fnmonitor_app_dir)"
DATA_DIR="$(fnmonitor_data_dir)"
LOG_FILE="$(fnmonitor_log_file)"
PID_FILE="$(fnmonitor_pid_file)"
CONFIG_FILE="$(fnmonitor_config_file)"

start_app() {
    if fnmonitor_is_running; then
        echo "${APP_NAME} is already running"
        exit 0
    fi
    fnmonitor_install_config
    mkdir -p "${DATA_DIR}"
    touch "${LOG_FILE}"
    nohup "${APP_DIR}/bin/fnmonitor-server" "${DATA_DIR}" >> "${LOG_FILE}" 2>&1 &
    echo $! > "${PID_FILE}"
    sleep 1
    if fnmonitor_is_running; then
        echo "${APP_NAME} started"
        exit 0
    fi
    echo "${APP_NAME} failed to start, see ${LOG_FILE}" >&2
    exit 1
}

stop_app() {
    local pid
    if [ -f "${PID_FILE}" ]; then
        pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            kill "${pid}" 2>/dev/null || true
            for _ in $(seq 1 20); do
                kill -0 "${pid}" 2>/dev/null || break
                sleep 1
            done
            if kill -0 "${pid}" 2>/dev/null; then
                kill -9 "${pid}" 2>/dev/null || true
            fi
        fi
    fi
    pkill -f "${APP_DIR}/fnmonitor" 2>/dev/null || true
    rm -f "${PID_FILE}"
    echo "${APP_NAME} stopped"
}

case "${1:-}" in
    start)
        start_app
        ;;
    stop)
        stop_app
        ;;
    status)
        if fnmonitor_is_running; then
            echo "${APP_NAME} is running"
            exit 0
        fi
        echo "${APP_NAME} is not running"
        exit 3
        ;;
    log)
        lines="${2:-100}"
        if [ -f "${LOG_FILE}" ]; then
            tail -n "${lines}" "${LOG_FILE}"
            exit 0
        fi
        echo "log file not found: ${LOG_FILE}" >&2
        exit 1
        ;;
    *)
        echo "usage: $0 {start|stop|status|log [lines]}" >&2
        exit 1
        ;;
esac
